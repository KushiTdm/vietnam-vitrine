# Copier en .env.local pour le dev local.
#
# Base absolue des démos, hébergées séparément sur le Worker Cloudflare.
# Sans elle, les liens et l'iframe de démo (DeviceFrame) pointent en relatif
# vers CE projet (vitrine), où les routes /demo/* n'existent pas.
# À définir aussi dans les Environment Variables du projet Vercel.
NEXT_PUBLIC_DEMOS_BASE_URL=https://hanoi-demos-site.san3neb.workers.dev

# Chatbot (app/api/chat) — clé Mistral AI, palier gratuit de La Plateforme.
# Sans elle, le widget répond « assistant indisponible » et renvoie vers le
# bouton de contact : la vitrine reste fonctionnelle. Ne jamais préfixer par
# NEXT_PUBLIC_ (elle serait inlinée dans le bundle client).
MISTRAL_API_KEY=

# Modèle utilisé par le chatbot. Facultatif — défaut : ministral-3b-latest.
# CHAT_MODEL=ministral-3b-latest

# Reclassement sémantique du RAG (embeddings). Actif par défaut dès que
# MISTRAL_API_KEY est définie et que lib/chat/kb/embeddings.json correspond au
# corpus. Le mettre à 0 pour n'utiliser que la recherche lexicale BM25 : une
# requête réseau de moins par message, donc moins de quota consommé.
# CHAT_RAG_EMBEDDINGS=0

# ── Suivi dans l'app mobile (Supabase) ──────────────────────────────────────
# Base PARTAGÉE avec neuraweb.fr : les écritures de Hanoi portent site='vn',
# celles de la France site='fr'. Sans ces deux variables, le chatbot et la
# prise de RDV fonctionnent quand même — rien n'est journalisé, c'est tout.
#
# SUPABASE_SERVICE_ROLE_KEY contourne la RLS : jamais de préfixe NEXT_PUBLIC_,
# jamais dans un dépôt, uniquement dans .env.local et dans Vercel.
SUPABASE_URL=https://szpqellzyyocenxufvsl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
