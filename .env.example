# Copier en .env.local pour le dev local.
#
# Base absolue des démos, hébergées séparément sur le Worker Cloudflare.
# Sans elle, les liens et l'iframe de démo (DeviceFrame) pointent en relatif
# vers CE projet (vitrine), où les routes /demo/* n'existent pas.
# À définir aussi dans les Environment Variables du projet Vercel.
NEXT_PUBLIC_DEMOS_BASE_URL=https://hanoi-demos-site.san3neb.workers.dev
